NODE_ENV = 'production'
# 必须为 false：为 true 时 esbuild 会删除所有 console 调用，
# 连接手机调试（adb logcat / HBuilderX 控制台）将看不到任何日志。
# 上线前若不需要日志，可改为 true。
VITE_DELETE_CONSOLE = false
VITE_SHOW_SOURCEMAP = false

# 正式环境关闭 devServer 代理，直连接口域名
VITE_APP_PROXY_ENABLE = false

# 日志开关（配合 VITE_DELETE_CONSOLE = false 使用）
VITE_LOG_ENABLE = true

# ---------------------------------------------------------------------------
# 一起看 · 通话服务
#
# 服务端为独立仓库 `yinghua-rtc-server`（信令 + TURN），Docker 部署。
# 见该仓库 README。
#
# ⚠️ 这两项**必须显式配置**：正式包若留空，信令会退回海外的公共 lobby 服务，
# 且 ICE 只用 STUN —— 结果就是「只有同一 WiFi 能视频通话」。
# ---------------------------------------------------------------------------
VITE_RTC_SIGNAL_URL = https://rtc.zyca.top
VITE_RTC_ICE_CONFIG_URL = https://rtc.zyca.top
