NODE_ENV = 'development'
VITE_DELETE_CONSOLE = false
VITE_SHOW_SOURCEMAP = false

VITE_APP_PROXY_ENABLE = true

# ---------------------------------------------------------------------------
# 一起看 · 通话服务
#
# 开发时指向**服务器上的自建服务**（见独立仓库 yinghua-rtc-server）。
#
# 为什么不指向本地 localhost：
#   通话需要两端分别位于不同网络才能验证「跨网络是否真的打通」。
#   本地跑服务时两端都在同一台机器/同一 WiFi 下，走 host 候选就能通，
#   反而掩盖了 TURN 是否生效 —— 那正是要验证的东西。
#
# 若确需本地调试服务端，改成 http://你的局域网IP:3000 即可；
# 注意 H5 端在 http + 局域网 IP 下拿不到摄像头（非安全上下文）。
# ---------------------------------------------------------------------------
VITE_RTC_SIGNAL_URL = https://rtc.zyca.top
VITE_RTC_ICE_CONFIG_URL = https://rtc.zyca.top
