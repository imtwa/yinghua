VITE_APP_TITLE = '映话'
VITE_APP_PORT = 9010

VITE_UNI_APPID = '__UNI__C70B7E8'
VITE_WX_APPID = ''

# h5 部署 base，与 manifest.config.ts 的 h5.router.base 对齐
VITE_APP_PUBLIC_BASE = /

VITE_FALLBACK_LOCALE = 'zh-Hans'

# 内容源在 src/constants/source.ts 中配置（苹果CMS v10 标准接口）

# 片源可用性探测：取到地址后先验证再交给播放器
# H5 端会自动跳过（CDN 无 CORS 头，浏览器探测必失败）
VITE_PLAY_PROBE_ENABLE = true
# 探测超时（毫秒）
VITE_PLAY_PROBE_TIMEOUT = 8000

# 运行日志开关（连手机调试时通过 adb logcat / HBuilderX 控制台查看）
VITE_LOG_ENABLE = true

# ---------------------------------------------------------------------------
# 一起看 · 通话服务
#
# 服务端为独立仓库 `yinghua-rtc-server`（信令 + TURN），用 Docker 部署。
# 部署与排查见该仓库 README。
#
# ⚠️ 未配置的后果：
#   信令会退回内置的公共 lobby 服务（海外、不稳定）；
#   ICE 只用内置 STUN —— 同一 WiFi 能通话，换到移动网络/别人手机必然连不上
#   （国内移动网络多为对称型 NAT，打洞必须依赖 TURN 中继）。
# ---------------------------------------------------------------------------

# 信令服务地址（socket.io）—— 经反向代理的 https 域名
VITE_RTC_SIGNAL_URL = https://rtc.zyca.top

# ICE 配置接口基址（信令服务的 /rtc-config 下发 TURN 临时凭据）
# 与信令地址同源，填相同值即可
VITE_RTC_ICE_CONFIG_URL = https://rtc.zyca.top
