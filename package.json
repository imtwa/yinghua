{
    "name": "yinghua",
    "type": "module",
    "version": "1.0.0",
    "description": "映话 - 一起看，聊着看。影视聚合与双人同步观影",
    "unibest": {
        "platforms": ["h5", "app"],
        "uiLibrary": "wot-ui",
        "loginStrategy": false,
        "i18n": true,
        "chartLibraries": [],
        "cliVersion": "4.0.15",
        "unibestVersion": "4.3.0"
    },
    "packageManager": "pnpm@10.10.0",
    "engines": {
        "node": ">=20",
        "pnpm": ">=9"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "prepare": "pnpm init-husky",
        "init-husky": "git init && husky",
        "gen:icons": "node ./scripts/gen-icons.mjs",
        "predev": "node ./scripts/create-base-files.js",
        "predev:app": "node ./scripts/create-base-files.js",
        "prebuild:app": "node ./scripts/gen-icons.mjs && node ./scripts/create-base-files.js",
        "dev": "uni",
        "dev:h5": "uni",
        "dev:h5:prod": "uni --mode production",
        "dev:app": "uni -p app",
        "dev:app-android": "uni -p app-android",
        "dev:app-ios": "uni -p app-ios",
        "build": "uni build",
        "build:h5": "uni build",
        "build:h5:prod": "uni build --mode production",
        "build:app": "uni build -p app",
        "build:app-android": "uni build -p app-android",
        "build:app-ios": "uni build -p app-ios",
        "type-check": "vue-tsc --noEmit",
        "lint-staged": "lint-staged",
        "lint:prettier": "prettier --check .",
        "lintfix": "prettier --write --list-different ."
    },
    "dependencies": {
        "@dcloudio/uni-app": "3.0.0-5000620260331001",
        "@dcloudio/uni-app-plus": "3.0.0-5000620260331001",
        "@dcloudio/uni-components": "3.0.0-5000620260331001",
        "@dcloudio/uni-h5": "3.0.0-5000620260331001",
        "crypto-es": "^3.1.3",
        "dayjs": "1.11.10",
        "pinia": "2.0.36",
        "pinia-plugin-persistedstate": "3.2.1",
        "vue": "^3.4.21",
        "wot-design-uni": "latest",
        "z-paging": "2.8.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@dcloudio/types": "^3.4.8",
        "@dcloudio/uni-cli-shared": "3.0.0-5000620260331001",
        "@dcloudio/uni-stacktracey": "3.0.0-5000620260331001",
        "@dcloudio/uni-uts-v1": "3.0.0-5000620260331001",
        "@dcloudio/vite-plugin-uni": "3.0.0-5000620260331001",
        "@iconify-json/carbon": "^1.2.4",
        "@iconify/utils": "^3.0.2",
        "@types/node": "^20.17.9",
        "@uni-helper/plugin-uni": "0.1.0",
        "@uni-helper/uni-env": "0.1.8",
        "@uni-helper/uni-types": "1.0.0-alpha.6",
        "@uni-helper/unocss-preset-uni": "0.2.11",
        "@uni-helper/vite-plugin-uni-components": "0.2.3",
        "@uni-helper/vite-plugin-uni-layouts": "0.1.11",
        "@uni-helper/vite-plugin-uni-manifest": "0.2.12",
        "@uni-helper/vite-plugin-uni-pages": "0.3.23",
        "@uni-helper/vite-plugin-uni-platform": "0.0.5",
        "@uni-ku/bundle-optimizer": "v1.3.15-beta.2",
        "@uni-ku/root": "1.4.1",
        "@unocss/preset-legacy-compat": "66.0.0",
        "@vue/tsconfig": "^0.1.3",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.10",
        "miniprogram-api-typings": "^4.1.0",
        "postcss": "^8.4.49",
        "postcss-html": "^1.8.0",
        "prettier": "^3.5.3",
        "sass": "1.77.8",
        "typescript": "~5.8.0",
        "unocss": "66.0.0",
        "unplugin-auto-import": "^20.0.0",
        "vite": "5.2.8",
        "vite-plugin-restart": "^1.0.0",
        "vue-tsc": "^3.0.6"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,css,sass,less,styl,vue,nvue,htm,html}": ["prettier --write"]
    },
    "pnpm": {
        "overrides": {
            "unconfig": "7.3.2"
        }
    },
    "overrides": {
        "unconfig": "7.3.2"
    },
    "resolutions": {
        "bin-wrapper": "npm:bin-wrapper-china",
        "unconfig": "7.3.2"
    }
}
